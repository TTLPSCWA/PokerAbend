# Für den Server: kopieren nach .env und anpassen. Die .env kommt nie zu GitHub.
DOMAIN=tobiasthomasprojektap2.de
IMAGE=ghcr.io/ttlpscwa/pokerabend:latest

# ---------- Anmeldung mit Discord ----------
# Aus dem Discord Developer Portal → deine Anwendung → OAuth2
DISCORD_CLIENT_ID=
# Client Secret (geheim halten, nie weitergeben)
DISCORD_CLIENT_SECRET=
# Server-ID unseres Discord-Servers (Entwicklermodus an → Rechtsklick auf den Server → „Server-ID kopieren“)
DISCORD_GUILD_ID=
# Optional: nur Mitglieder mit dieser Rolle (leer = alle Mitglieder des Servers)
DISCORD_ROLE_ID=
# Adresse der Seite, ohne / am Ende. Lokal: http://localhost:3000, auf dem Server: https://tobiasthomasprojektap2.de
PUBLIC_URL=http://localhost:3000

# ---------- Ohne Discord ----------
# Nur wenn DISCORD_CLIENT_ID leer ist: Passwort für die ganze Seite.
# Ist beides leer, ist die Seite offen (nur lokal zum Testen).
SITE_PASSWORD=
