# Für den Server: kopieren nach .env und anpassen. Die .env kommt nie zu GitHub.
DOMAIN=poker.scwagaming.com
IMAGE=ghcr.io/ttlpscwa/pokerabend:latest

# Gruppenpasswort für die ganze Seite. Wer es nicht kennt, sieht nur die Passwort-Seite.
# Auf dem Server Pflicht. Lokal leer = Seite offen (nur zum Testen).
SITE_PASSWORD=

# Eigenes Passwort für Statusverwaltung und Moderation im Ticket-Board.
# Leer lassen = Board nutzbar, Verwaltungsanmeldung ausgeschaltet.
TICKET_ADMIN_PASSWORD=

# Eigenes Passwort für die Admin-Seite /admin (Räume, Zustand, Update ankündigen). Hat nichts mit dem Gruppenpasswort zu tun.
# Leer lassen = /admin ist ausgeschaltet.
ADMIN_PASSWORD=

# ---- Optional: Anmeldung mit Discord (V2-02) ----
# Ohne DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET und PUBLIC_URL ist Discord komplett aus (kein Knopf, Routen antworten 404).
# Einrichtung Schritt für Schritt: README, Abschnitt „Discord-Anmeldung einrichten“. Das Secret gehört nur in die .env, nie in Git.
# Anwendungs-ID (öffentlich) der vorhandenen Discord-App:
DISCORD_CLIENT_ID=1563578924007694346
# Client Secret aus dem Discord Developer Portal (OAuth2 → Client Secret → „Reset Secret“)
DISCORD_CLIENT_SECRET=
# Öffentliche Adresse der Seite OHNE Schrägstrich am Ende, z. B. https://poker.scwagaming.com – daraus entsteht die Redirect-URI
PUBLIC_URL=https://poker.scwagaming.com
# Discord-Server (Rechtsklick auf den Server → „Server-ID kopieren“, Entwicklermodus nötig).
# Gesetzt: Mitglieder dieses Servers kommen per Discord ohne Gruppenpasswort hinein. Leer: Discord dient nur zum Verknüpfen des Kontos.
DISCORD_GUILD_ID=
# Optional: nur Mitglieder mit dieser Rolle (Rollen-ID) kommen per Discord hinein
DISCORD_ROLE_ID=

# ---- Funktionen ein-/ausschalten (V2-10) ----
# Werte: on oder off. Leer = Standard. Zur Laufzeit lässt sich alles auch unter /admin → „Funktionen & Spiele“ umlegen; die Admin-Einstellung gewinnt, „Zurücksetzen“ führt hierher zurück.
# Anmeldung mit Discord ausschalten (Standard: an, wirkt aber nur, wenn Discord oben eingerichtet ist)
FEATURE_DISCORD=
# Ranked-Wertung (Standard: an). Aus = neue Runden zählen nicht für die Ranked-Bestenliste; alte Ergebnisse und die Namensstatistik bleiben
FEATURE_RANKED=
# Kamera/Video – noch ohne Funktion, für später reserviert (Standard: aus)
FEATURE_CAMERA=
# Einzelne Spiele abschalten: Spiel-IDs mit Komma getrennt, z. B. blackjack,sudoku (IDs stehen in /admin → Funktionen & Spiele). Leer = alle an
DISABLED_GAMES=

# ---- Optional: Feinabstimmung (Standardwerte stehen in docs/betrieb.md) ----
# SESSION_SECRET=           # feste Schlüsselbasis; leer = der Server erzeugt und speichert einen eigenen im Datenordner
# MAX_ROOMS=50              # gleichzeitig offene Tische
# CREATE_LIMIT=6            # neue Tische je Anschluss und 10 Minuten
# API_LIMIT=900             # Anfragen je Anschluss und Minute an /api
# NEW_ACCOUNT_LIMIT=30      # neue Gast-Konten je Anschluss und 10 Minuten
# MAX_CONN_PER_IP=30        # gleichzeitige Verbindungen je Anschluss
# PLAYER_TIMEOUT_MIN=5      # so lange darf ein Spieler offline sein, bevor er den Platz verliert
# UPDATE_ANNOUNCE_MIN=5     # Vorlauf bei einer Update-Ankündigung per Signal
# UPDATE_DRAIN_MAX_MIN=15   # so lange dürfen laufende Runden nach Fristende noch fertig werden
