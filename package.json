{
  "name": "pokerabend",
  "version": "3.6.0",
  "description": "Spieleabend für die Freundesgruppe – Karten-, Würfel-, Brett- und Partyspiele im Browser, dazu lokale Einzelspieler",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test:fast": "node scripts/test-fast.mjs",
    "monopoly:theme-build": "node scripts/build-monopoly-theme.mjs",
    "monopoly:theme-verify": "node scripts/verify-monopoly-theme.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:ui": "playwright test",
    "test:smoke": "playwright test test/ui/smoke.spec.js",
    "test:coverage": "node scripts/test-all.mjs --only=node",
    "coverage:worst": "node scripts/coverage-worst.mjs reports/coverage 20",
    "test:all": "node scripts/test-all.mjs",
    "test:all:docker": "node scripts/test-all-docker.mjs",
    "test:report": "playwright show-report reports/playwright-html",
    "export:design": "node scripts/export-design.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "chess.js": "1.4.0",
    "express": "^4.22.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "c8": "^10.1.3",
    "socket.io-client": "^4.8.4"
  }
}
